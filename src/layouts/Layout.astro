---
import "../styles/global.css";
import Chrome from "../components/Chrome.astro";
// police des titres (le plus grand texte du premier écran), préchargée
import fontDisplay from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  /** "home" active les scènes de l'accueil */
  page?: string;
}

const {
  title = "LOGIQ IA · L'IA qui transforme votre entreprise",
  description = "LOGIQ IA, cabinet d'ingénierie IA à Gréoux-les-Bains (Provence) : agents IA sur mesure, automatisation, sites web et plateformes métier, produits IA. Audit offert de 30 minutes, intervention partout en France.",
  canonical = "https://logiq-ia.fr/",
  keywords = "LOGIQ IA, agent IA, automatisation, création de site web, intelligence artificielle entreprise, Manga AI, Apidia, Gréoux-les-Bains, Manosque, Provence, PACA",
  page = "",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Drapeaux posés avant le premier rendu : JS présent, arrivée par le rideau */}
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.className = r.className.replace("no-js", "js");
        try {
          var s = sessionStorage;
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (s.getItem("lq-wipe")) { s.removeItem("lq-wipe"); if (!reduce) r.classList.add("is-arriving"); }
        } catch (e) {}
      })();
    </script>

    <link rel="preload" as="font" type="font/woff2" href={fontDisplay} crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="LOGIQ IA" />
    <meta name="geo.region" content="FR-04" />
    <meta name="geo.placename" content="Gréoux-les-Bains, Alpes-de-Haute-Provence" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="LOGIQ IA" />
    <meta property="og:image" content="https://logiq-ia.fr/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LOGIQ IA · L'IA qui transforme votre entreprise" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://logiq-ia.fr/og.jpg" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "LOGIQ IA",
        url: "https://logiq-ia.fr",
        logo: "https://logiq-ia.fr/logo.png",
        slogan: "L'IA qui transforme votre entreprise",
        description:
          "Cabinet d'ingénierie IA : agents IA sur mesure, automatisation, sites web et plateformes métier. Concepteur et éditeur de produits IA grand public et métier.",
        email: "contact@logiq-ia.fr",
        founder: { "@type": "Person", name: "Quentin Duroy", url: "https://quentin-duroy.fr" },
        knowsAbout: [
          "Agents IA",
          "Automatisation des processus",
          "Création de sites web",
          "Intelligence artificielle générative",
          "Make",
          "n8n",
          "Développement de jeux vidéo",
        ],
        address: {
          "@type": "PostalAddress",
          addressLocality: "Gréoux-les-Bains",
          addressRegion: "Provence-Alpes-Côte d'Azur",
          postalCode: "04800",
          addressCountry: "FR",
        },
        areaServed: [
          { "@type": "AdministrativeArea", name: "Provence-Alpes-Côte d'Azur" },
          { "@type": "Country", name: "France" },
        ],
        sameAs: [
          "https://www.linkedin.com/company/logiq-ia",
          "https://manga-ai.fr",
        ],
        owns: [
          {
            "@type": "SoftwareApplication",
            name: "Manga AI",
            url: "https://manga-ai.fr",
          },
        ],
      })}
    />
  </head>
  <body class="min-h-screen overflow-x-hidden antialiased" data-page={page}>
    <slot />
    <Chrome />
  </body>
</html>
