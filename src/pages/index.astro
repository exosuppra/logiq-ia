const benefits = [
  { icon: "trending", color: "#7c3aed", title: "Du temps libéré, immédiatement", body: "Nos agents IA automatisent jusqu'à 80 % des tâches répétitives. Vos équipes se concentrent sur ce qui crée vraiment de la valeur." },
