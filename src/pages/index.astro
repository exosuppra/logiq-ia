    figlab: "sans supervision permanente",
    href: "/produits#oto",
  },
  {
    name: "Agent SDR autonome",
    role: "Prospection commerciale",
    body: "On lui confie un profil de client idéal : il identifie, qualifie, mène la conversation sur LinkedIn et décroche le rendez-vous — en décidant seul de ses actions.",
