];

type Site = { name: string; kind: string; tag: string; tagKind?: "new" | "concept"; img: string; href: string; url: string; note: string };
const sites: Site[] = [
  { name: "Cas'Design", kind: "Dessinateur · infographiste", tag: "Nouveau", tagKind: "new", img: "site-casdesign-2", href: "https://casdesign.fr", url: "casdesign.fr", note: "La maison se construit au scroll : le plan, le volume, puis la matière." },
  { name: "Madame Monsieur", kind: "Salon de coiffure · Gréoux-les-Bains", tag: "Nouveau", tagKind: "new", img: "site-madamemonsieur", href: "https://madamemonsieur-greoux.fr", url: "madamemonsieur-greoux.fr", note: "Un site vitrine chaleureux, relié à la prise de rendez-vous en ligne." },
  { name: "La Brasserie du Soleil", kind: "Brasserie · pizzeria · Gréoux-les-Bains", tag: "Nouveau", tagKind: "new", img: "site-brasserie", href: "https://www.labrasseriedusoleil.fr", url: "labrasseriedusoleil.fr", note: "La carte, la terrasse, les horaires : la table du village, en ligne." },
