      </div>
    </section>

    {/* =================================================================== FAQ */}
    <section class="cv sheet relative bg-white py-24 sm:py-32" data-section="FAQ">
      <div class="mx-auto max-w-3xl px-6">
        <div class="mb-12 text-center">
          <span class="sec-label" data-reveal="fade">Questions fréquentes</span>
          <h2 class="h-xl mt-6" style="color: #0a0a0a; font-size: clamp(2.2rem, 5vw, 4.4rem);">
            Vous vous demandez <em class="text-gradient">sûrement…</em>
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="group rounded-2xl border bg-white px-6 py-4" style="border-color: #e5e5e5;" data-reveal="fade">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold" style="color: #0a0a0a;">
                {f.q}
                <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4 shrink-0 transition-transform group-open:rotate-90" style="color: #6d28d9;" aria-hidden="true">
                  <path d="M6 3l5 5-5 5V3z" />
                </svg>
              </summary>
              <p class="mt-3 overflow-hidden text-sm leading-relaxed" style="color: #404040;">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* =================================================================== CTA */}
    <section class="cv cta" data-section="Contact">
      <div class="cta__media" aria-hidden="true"></div>
      <img class="cta__mascot" src="/mascotte/contact.webp" alt="" width="260" height="260" loading="lazy" decoding="async" data-reveal="pop" data-float="30" />
      <div class="relative mx-auto max-w-5xl px-6 text-center">
        <h2 class="cta__title" data-noreveal data-reveal="chars">
          Votre projet IA commence <em>ici.</em>
        </h2>
        <p class="mx-auto mt-8 max-w-xl text-lg" style="color: rgba(255,255,255,0.9);" data-reveal="fade">
          Audit offert en 30 minutes. À l'issue, vous repartez avec un
          diagnostic clair, un plan d'action concret et un devis transparent.
        </p>
        <div class="mt-10 flex justify-center" data-reveal="fade">
          <a
            href="/contact"
            data-magnet
            class="btn-x inline-flex items-center gap-2 rounded-full bg-white px-9 py-4 text-base font-semibold transition-colors hover:text-white"
            style="color: #0a0a0a; box-shadow: 0 18px 40px -14px rgba(13,7,24,0.6);"
          >
            Prendre rendez-vous
            <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M6 3l5 5-5 5V3z" /></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(gamesSchema)} />
</Layout>
