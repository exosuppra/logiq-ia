    figlab: "fiches actualisées chaque jour",
    href: "/produits#apidia",
  },
  {
    name: "OTO",
    role: "Agent chargé de projet web",
    body: "Il pilote lui-même ses automatisations et prend en charge une grande partie du quotidien d'un chargé de projet web : communication, contenus, coordination.",
