    figlab: "autonome, de l'ICP au rendez-vous",
    href: "/realisations",
  },
];

// Journée type reconstituée à titre d'illustration (voir la mention sous le terminal).
const log = [
  ["06:00", "apidia", "a1", "revue quotidienne des 6 000+ fiches"],
  ["06:04", "apidia", "a1", "horaires introuvables · recherche sur le web"],
  ["06:05", "apidia", "a1", "e-mail au propriétaire pour confirmation"],
  ["08:30", "oto", "a2", "publication du jour rédigée et programmée"],
  ["09:12", "oto_mail", "a4", "boîte triée · réponses préparées"],
  ["10:40", "oto", "a2", "ordre de mission généré"],
  ["11:02", "sdr", "a3", "prospects qualifiés selon le profil cible"],
  ["14:20", "sdr", "a3", "rendez-vous décroché · inscrit au CRM"],
  ["17:45", "oto_mail", "a4", "agenda et GRC à jour"],
