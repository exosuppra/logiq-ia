    figlab: "tâches prises en charge chaque jour",
    href: "/produits#oto",
  },
  {
    name: "OTO_Mail",
    role: "Agent e-mail, agenda & GRC",
    body: "Le binôme d'OTO pour la relation : il trie, rédige, enregistre et tient les bases agenda et GRC à jour sans supervision permanente.",
