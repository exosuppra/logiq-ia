  { name: "Le Jardin de Célina", kind: "Maison d'hôtes & restaurant · Valensole", tag: "Client", img: "site-celina", href: "https://lejardindecelina.com", url: "lejardindecelina.com", note: "Chambres, chalets, table signature et événementiel sur un même site." },
  { name: "L'Oustaù de Greù", kind: "Épicerie fine & cave · Gréoux-les-Bains", tag: "Client", img: "site-oustau", href: "https://loustaudegreu.fr", url: "loustaudegreu.fr", note: "Boutique en ligne de produits régionaux, comptes clients et livraison." },
  { name: "Esparron-de-Verdon", kind: "Guide touristique de destination", tag: "Tourisme", img: "site-esparron", href: "https://esparron-de-verdon.lovable.app", url: "esparron-de-verdon", note: "Activités, agenda, hébergements et patrimoine réunis en un guide clair." },
  { name: "Verdon Mystères", kind: "Jeu d'énigmes grandeur nature", tag: "Loisir", img: "site-verdonmysteres", href: "https://verdon-mysteres.lovable.app", url: "verdon-mysteres", note: "Le site du jeu, prolongé par un mini-jeu jouable dans le navigateur." },
  { name: "RENOVXPERTS", kind: "Artisan rénovation multi-métiers", tag: "Client", img: "site-renovxperts", href: "https://renovxperts-geo-engine.lovable.app", url: "renovxperts", note: "Génération de demandes de devis pour un artisan local." },
  { name: "La Pièce qui attend", kind: "Site officiel du jeu", tag: "Jeu vidéo", img: "site-lpqa", href: "https://exosuppra.github.io/la-piece-qui-attend-site/", url: "la-piece-qui-attend", note: "Le dossier d'enquête du jeu : bande-annonce, guides et kit presse." },
];

// Captures réelles, prises dans les jeux (dossiers des projets).
const games = [
  { name: "La Pièce qui attend", kind: "Horreur psychologique · enquête à la première personne", status: "Jeu complet · bientôt sur Steam", shots: ["lpqa-2", "lpqa-1", "lpqa-3", "lpqa-4"], href: "https://exosuppra.github.io/la-piece-qui-attend-site/", torch: true, wide: true },
  { name: "Aubelune", kind: "Aventure narrative · JRPG et romance · Unreal Engine 5", status: "Refonte 3D en cours", shots: ["aubelune-1", "aubelune-2", "aubelune-3"] },
  { name: "Escale", kind: "Farming RPG en pixel art · titre de travail", status: "Prototype jouable", shots: ["escale-2", "escale-1", "escale-3"] },
  { name: "La Dernière Tournée", kind: "Jeu narratif low-poly · la dernière tournée d'un facteur", status: "Prototype jouable", shots: ["tournee-1", "tournee-2", "tournee-3"] },
  { name: "Chœur de Sel", kind: "FPS narratif stylisé · artworks du jeu", status: "Build jouable", shots: ["choeur-1", "choeur-2"] },
];

// Les karts présentés en 3D sur la page (modèles du jeu).
const pilots = [
  { id: "boulon", name: "Boulon", kart: "La Fusée" },
  { id: "picante", name: "El Picante", kart: "La Flamme" },
];

// Cinématiques d'ouverture des circuits, capturées en jeu.
const circuits = [
  ["paris-grisou", "Toits de Paris"],
  ["nice", "Corso de Nice"],
  ["station", "Station Croissant"],
  ["depart", "Volcan Tiki · départ"],
  ["phare", "Phare de la Marée"],
  ["potager", "Potager Géant"],
  ["labo", "Labo de la Pr Bécher"],
  ["noel", "Marché de Noël"],
  ["pyramide", "Pyramide Pharaonique"],
  ["zazie", "Forêt de Zazie"],
  ["grenier", "Grenier aux Jouets"],
  ["poulpe", "Épave du Poulpe"],
  ["marmottes", "Col des Marmottes"],
  ["fromages", "Caverne aux Fromages"],
  ["versailles", "Jardins de Versailles"],
];

const steps = [
  { n: "01", title: "Audit — 30 min offertes", body: "On regarde votre métier, vos outils, vos points de friction. Vous repartez avec un diagnostic clair et un devis transparent." },
  { n: "02", title: "Conception", body: "Une solution calibrée sur votre réalité : vos processus, vos outils existants, votre budget. Pas d'usine à gaz." },
  { n: "03", title: "Déploiement", body: "Premier livrable opérationnel sous 2 à 4 semaines. Itérations rapides selon vos retours terrain." },
  { n: "04", title: "Opération", body: "On ne disparaît pas après la livraison : supervision, maintenance et amélioration continue dans la durée." },
];

const clients = [
  "Office de Tourisme du Pays de Manosque",
  "Le Jardin de Célina",
  "L'Oustaù de Greù",
  "Madame Monsieur",
  "La Brasserie du Soleil",
  "Cas'Design",
  "RENOVXPERTS",
];

const mosaic = [
  ["site-casdesign", "k-paris-grisou", "site-manoztralia", "mg-cover", "site-madamemonsieur", "lpqa-2", "site-celina"],
  ["site-brasserie", "k-nice", "site-oustau", "aubelune-1", "site-casdesign-2", "k-station", "site-esparron"],
  ["site-verdonmysteres", "escale-1", "site-renovxperts", "k-depart", "site-manoztralia-1", "tournee-1", "site-lpqa"],
];

const bandWords = ["Agents IA", "Automatisation", "Sites web", "Produits IA", "Jeux vidéo", "Conseil"];

const faqs = [
  {
    q: "Combien coûte un projet IA avec LOGIQ IA ?",
    a: "Chaque projet démarre par un audit offert de 30 minutes, à l'issue duquel vous recevez un devis transparent. Nos solutions sont calibrées pour les PME : pas de licences à six chiffres, un ROI visé dès le premier trimestre.",
  },
  {
    q: "En combien de temps voit-on des résultats ?",
    a: "Le premier livrable opérationnel arrive sous 2 à 4 semaines. Les quick wins sont identifiés dès l'audit, et certaines automatisations produisent des gains dès la première semaine.",
  },
  {
    q: "Êtes-vous conformes au RGPD et à l'EU AI Act ?",
    a: "Oui. Conformité RGPD et EU AI Act native, hébergement européen. Pour les cas sensibles, nous savons opérer sur une infrastructure souveraine 100 % locale, sans API cloud.",
  },
  {
    q: "Faut-il des compétences techniques en interne ?",
    a: "Non. Nous concevons, déployons et opérons la solution pour vous, et nous formons vos équipes à son utilisation. Vous gardez la main sans avoir besoin d'un service informatique.",
  },
  {
    q: "Travaillez-vous uniquement avec le secteur du tourisme ?",
    a: "Non. Le tourisme est notre terrain d'origine, mais nous travaillons aussi avec des commerces, des artisans, de l'hôtellerie-restauration et des éditeurs de SaaS — voir nos réalisations.",
  },
  {
    q: "Que se passe-t-il après la mise en production ?",
    a: "Nous opérons la solution dans la durée : supervision, alertes en cas d'incident, maintenance et évolutions au fil de vos besoins. Vous n'êtes jamais seul avec la technologie.",
  },
];

// Les deux jeux publiquement présentés, décrits pour les moteurs de recherche.
const gamesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "LOGIQ IA",
      url: "https://logiq-ia.fr",
      inLanguage: "fr-FR",
      publisher: { "@type": "Organization", name: "LOGIQ IA", url: "https://logiq-ia.fr" },
    },
    {
      "@type": "VideoGame",
      name: "Kartoche",
      genre: "Course de karts arcade",
      gamePlatform: "PC",
      description: "Jeu de course de karts arcade à l'humour français : 28 pilotes, 24 karts, 23 circuits. Développé en C++ sur Unreal Engine 5.",
      author: { "@type": "Organization", name: "LOGIQ IA", url: "https://logiq-ia.fr" },
    },
    {
      "@type": "VideoGame",
      name: "La Pièce qui attend",
      genre: "Horreur psychologique",
      gamePlatform: "PC",
      url: "https://exosuppra.github.io/la-piece-qui-attend-site/",
      description: "Jeu d'horreur psychologique et d'enquête à la première personne.",
      author: { "@type": "Organization", name: "LOGIQ IA", url: "https://logiq-ia.fr" },
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout page="home">
  <Header />

  <main class="bg-white">
    {/* ================================================================ HERO */}
    <section class="hero" data-section="Accueil" data-intro>
      <div class="hero__pin">
        <NeuralBg />

        {/* Fenêtre sur les créations : s'ouvre en plein écran au scroll.
            Ses vignettes sont chargées par le script, après le premier affichage. */}
        <div class="hero__stage" aria-hidden="true">
          <div class="hero__mover">
            <div class="hero__drift">
              {mosaic.map((row) => (
                <div class="mosaic-row">
                  {[...row, ...row].map((n) => (
                    <img data-src={`/show/m-${n}.webp`} alt="" width="320" height="200" decoding="async" />
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="hero__veil"></div>
          <div class="hero__shade"></div>
        </div>
        <div class="hero__ring" aria-hidden="true"></div>
        <div class="hero__slot" aria-hidden="true"></div>

        <div class="hero__badge" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <defs><path id="badge-arc" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
            <text><textPath href="#badge-arc">sites · agents ia · produits · jeux vidéo ·</textPath></text>
          </svg>
          <img src="/logo-mark-128.webp" alt="" width="56" height="56" />
        </div>

        <div class="hero__a">
          <div class="hero__a-in">
            <div class="hero__col">
              <div
                class="hero__kicker inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
                style="border-color: rgba(220,38,38,0.30); background: rgba(255,255,255,0.7); color: #b91c1c;"
              >
                <span class="relative flex h-1.5 w-1.5">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background: #ef4444;"></span>
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full" style="background: #dc2626;"></span>
                </span>
                Cabinet d'ingénierie IA
              </div>

              <h1 class="hero__title">
                L'IA qui <span class="text-gradient">transforme</span> votre entreprise.
              </h1>

              <p class="hero__lead">
                <strong style="color: #0a0a0a;">LOGIQ IA</strong> conçoit, déploie et opère des
                agents IA, automatisations et plateformes qui livrent. Des solutions
                pensées pour le terrain, prêtes à tourner dès la première semaine.
              </p>

              <div class="hero__ctas mt-8 flex flex-col items-start gap-4 sm:flex-row">
                <a
                  href="/contact"
                  data-magnet
                  class="btn-x inline-flex items-center gap-2 rounded-full px-8 py-3.5 text-base font-semibold text-white"
                  style="background: linear-gradient(90deg, #7c3aed 0%, #c026d3 50%, #dc2626 100%); box-shadow: 0 12px 30px -10px rgba(124,58,237,0.45);"
                >
                  Réserver un audit gratuit
                  <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path d="M6 3l5 5-5 5V3z" />
                  </svg>
                </a>
                <a
                  href="/realisations"
                  class="hero__cta2 inline-flex items-center gap-2 rounded-full border bg-white/70 px-8 py-3.5 text-base font-semibold backdrop-blur transition-all hover:-translate-y-0.5"
                  style="border-color: #d4d4d4; color: #0a0a0a;"
                >
                  Voir nos réalisations
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="hero__b" aria-hidden="true">
          <span class="hero__b-kicker">Tout sort du même atelier</span>
          <p class="hero__b-title">Sites. Agents IA.<br />Produits. <em>Jeux.</em></p>
          <ul class="hero__chips">
            <li>Agents IA autonomes</li>
            <li>Automatisations Make &amp; n8n</li>
            <li>Sites &amp; plateformes</li>
            <li>Produits IA</li>
            <li>Jeux vidéo</li>
          </ul>
        </div>

        <span class="hero__scroll mono" aria-hidden="true">Scrollez pour ouvrir ↓</span>
      </div>
    </section>

    {/* ===================================================== BANDEAU INCLINÉ */}
    <div class="band mq" data-speed="90" aria-hidden="true">
      <div class="mq__track">
        <div class="mq__group">
          {bandWords.map((w) => (<span>{w} <i>✺</i></span>))}
        </div>
      </div>
    </div>

    {/* =========================================================== MANIFESTE */}
    <section class="manifesto" data-section="Manifeste">
      <div class="mx-auto max-w-6xl px-6">
        <span class="sec-label" data-reveal="fade">Ce qu'on fabrique</span>
        <p class="manifesto__text mt-8" data-manifesto>
          LOGIQ IA est un cabinet d'ingénierie IA. On y conçoit des agents
          <span class="pill-img pill-img--fit nosplit"><img loading="lazy" src="/show/p-agents.webp" alt="" width="160" height="160" /></span>
          autonomes, des automatisations
          <span class="pill-img pill-img--fit nosplit"><img loading="lazy" src="/show/p-automatisation.webp" alt="" width="160" height="160" /></span>
          qui tournent pendant que vous dormez, des sites
          <span class="pill-img nosplit"><img loading="lazy" src="/show/m-site-casdesign-2.webp" alt="" width="320" height="200" /></span>
          qui se remarquent — et même des jeux vidéo
          <span class="pill-img nosplit"><img loading="lazy" src="/show/m-k-nice.webp" alt="" width="320" height="200" /></span>.
          Puis on les opère, en production, dans la durée.
        </p>

        <div class="stats">
          <div class="stat">
            <span class="stat__line" data-line></span>
            <div class="stat__num"><span data-count="100">100</span>+</div>
            <div class="stat__lab">automatisations en production</div>
          </div>
          <div class="stat">
            <span class="stat__line" data-line></span>
            <div class="stat__num"><span data-count="6000">6 000</span>+</div>
            <div class="stat__lab">fiches actualisées chaque jour par Apidia</div>
          </div>
          <div class="stat">
            <span class="stat__line" data-line></span>
            <div class="stat__num"><span data-count="23">23</span></div>
            <div class="stat__lab">certifications IA · Anthropic, Make, Lovable</div>
          </div>
          <div class="stat">
            <span class="stat__line" data-line></span>
            <div class="stat__num"><span data-count="4.8" data-dec="1">4,8</span>/5</div>
            <div class="stat__lab">satisfaction webinaire FROT</div>
          </div>
        </div>
      </div>
    </section>

    {/* ============================================================ BÉNÉFICES */}
    <section class="cv sheet relative bg-neutral-50 py-24 sm:py-32" data-section="Le constat">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-16 grid items-center gap-10 lg:grid-cols-[1.5fr_1fr]">
          <div class="max-w-2xl">
            <span class="sec-label" data-reveal="fade">Le constat</span>
            <h2 class="h-xl mt-6" style="color: #0a0a0a;">
              Vos équipes méritent mieux que le <em class="text-gradient">copier-coller</em>.
            </h2>
            <p class="mt-5 text-lg" style="color: #404040;" data-reveal="fade">
              Saisies en double, emails répétitifs, reporting à la main : autant
              d'heures perdues chaque semaine. Voici ce que l'IA bien conçue
              change, concrètement.
            </p>
          </div>
          <img
            src="/mascotte/automatisation.webp"
            alt=""
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
            data-reveal="pop"
            data-float="26"
            class="mx-auto hidden w-64 select-none lg:block xl:w-72"
          />
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {benefits.map((b) => (
            <article class="flex gap-5 rounded-2xl border bg-white p-6" style="border-color: #e5e5e5;" data-reveal="tilt">
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl"
                style={`background: ${b.color}14; border: 1px solid ${b.color}38; color: ${b.color};`}
              >
                <Icon name={b.icon} size={22} />
              </div>
              <div>
                <h3 class="text-lg font-bold tracking-tight" style="color: #0a0a0a;">{b.title}</h3>
                <p class="mt-2 text-base leading-relaxed" style="color: #404040;">{b.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

